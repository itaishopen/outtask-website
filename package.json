{
  "name": "outtask-website",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nx run-many --target=serve --projects=api,web --parallel",
    "dev:web": "nx serve web",
    "dev:admin": "nx serve admin",
    "dev:api": "nx serve api",
    "build": "nx run-many --target=build --all",
    "build:web": "nx build web",
    "build:admin": "nx build admin",
    "build:api": "nx build api",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "db:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\""
  },
  "devDependencies": {
    "@nx/angular": "^22.7.1",
    "@nx/nest": "^22.7.1",
    "@nx/node": "^22.7.1",
    "@nx/js": "^22.7.1",
    "@nx/eslint": "^22.7.1",
    "@nx/eslint-plugin": "^22.7.1",
    "nx": "^22.7.1",
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular-devkit/build-angular": "^21.2.10",
    "typescript": "^6.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.5.0",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "@playwright/test": "^1.50.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.5.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.2.0"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0"
  }
}
