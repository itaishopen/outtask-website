# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://outtask:outtask_dev_password@localhost:5432/outtask"

# ─── API Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200,http://localhost:4201
ADMIN_URL=http://localhost:4201

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_64_CHARS_MIN
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_STRING
JWT_REFRESH_EXPIRES_IN=7d

# ─── Microsoft Entra ID (Azure AD) ────────────────────────────────────────────
# Register an app at https://portal.azure.com → Azure Active Directory → App registrations
MICROSOFT_CLIENT_ID=REPLACE_WITH_AZURE_APP_CLIENT_ID
MICROSOFT_CLIENT_SECRET=REPLACE_WITH_AZURE_APP_CLIENT_SECRET
MICROSOFT_TENANT_ID=REPLACE_WITH_AZURE_TENANT_ID
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Comma-separated list of allowed email domains
ALLOWED_EMAIL_DOMAINS=outtask.nl

# ─── Rate Limiting ────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── Storage ──────────────────────────────────────────────────────────────────
# Options: local, azure, s3
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
LOCAL_PUBLIC_URL=http://localhost:3000/uploads

# Azure Blob Storage (if STORAGE_PROVIDER=azure)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
# AZURE_STORAGE_CONTAINER=outtask-media

# S3 (if STORAGE_PROVIDER=s3)
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
# S3_SECRET_KEY=REPLACE_WITH_SECRET_KEY
# S3_BUCKET=outtask-media

# ─── Angular Web App ──────────────────────────────────────────────────────────
# (Set in Angular environment.ts for client, set here for SSR)
API_URL=http://localhost:3000/api

# ─── Angular Admin App ────────────────────────────────────────────────────────
# Set in apps/admin/src/environments/environment.ts
# MSAL client ID must match MICROSOFT_CLIENT_ID above
# Admin redirect URI: http://localhost:4201/auth/callback
